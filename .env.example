# Copy these values into your server environment. Never commit the real secrets.
PORT=8765
HOST=0.0.0.0
# Docker Compose host port for direct-IP testing.
GITHUB_IMAGE_HOST_PORT=8765
PUBLIC_BASE_URL=https://your-domain.example
# 经典 Token 登录，生产环境保持启用
ENABLE_TOKEN_LOGIN=true
# Optional site access control. Leave ALLOWED empty to allow all authenticated users.
ADMIN_GITHUB_LOGIN=
ALLOWED_GITHUB_LOGINS=
# Keep false unless you explicitly want to authorize repository deletion.
ENABLE_REPO_DELETE=false
