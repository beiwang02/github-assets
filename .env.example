# Copy these values into your server environment. Never commit the real secrets.
PORT=8080
HOST=0.0.0.0
# Docker Compose host port for direct-IP testing.
GITHUB_IMAGE_HOST_PORT=8765
PUBLIC_BASE_URL=https://your-domain.example
# GitHub OAuth App: callback must be https://your-domain.example/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=public_repo
# Optional; normally inferred from PUBLIC_BASE_URL.
# GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/github/callback
# Set true only for local migration/testing. Production should keep this false.
ENABLE_TOKEN_LOGIN=false
# Optional site access control. Leave ALLOWED empty to allow all authenticated users.
ADMIN_GITHUB_LOGIN=
ADMIN_RESTORE_REPO=
ALLOWED_GITHUB_LOGINS=
# Keep false unless you explicitly want to authorize repository deletion.
ENABLE_REPO_DELETE=false
